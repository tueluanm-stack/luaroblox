-- Đặt 1 unit (1 lần thử). Trả về true nếu đặt thành công.
local function deploySingleUnitOnce(unitName, targetPos)
    if not isRunning then return false end

    local mainHud = playerGui:FindFirstChild("MainHud")
    if not mainHud then return false end
    local elements  = mainHud:WaitForChild("Elements", 5)
    local hotbar    = elements:WaitForChild("Hotbar", 5)
    local mainframe = hotbar:WaitForChild("MainFrame", 5)
    if not (elements and hotbar and mainframe) then return false end

    -- Tìm slot (có thể đang ở mainframe hoặc bị kẹt ở elements từ lần trước)
    local slot = mainframe:FindFirstChild(unitName) or elements:FindFirstChild(unitName)
    if not slot then
        warn("❌ Không tìm thấy slot: " .. unitName)
        return false
    end

    -- B1: Đưa slot ra giữa màn hình để click được
    slot.Parent      = elements
    slot.AnchorPoint = Vector2.new(0.5, 0.5)
    slot.Position    = UDim2.new(0.5, 0, 0.5, 0)
    task.wait(STEP_DELAY)

    -- B2: Teleport nhân vật + khoá camera nhìn xuống đất
    local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local head = char and char:FindFirstChild("Head")

    if root and head then
        root.CFrame = CFrame.new(targetPos)
        localPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
        task.wait(0.12)
        local cam = workspace.CurrentCamera
        if cam then
            cam.CFrame = CFrame.lookAt(head.Position, head.Position + CAMERA_LOOK)
        end
    end
    task.wait(STEP_DELAY)

    -- B3: Click chọn slot tướng
    forceClickObject(slot)
    task.wait(STEP_DELAY)

    -- B4: Click nút đặt (PlaceButton) – chờ nút sẵn sàng tối đa ~1s
    local placeBtn
    local pbDeadline = os.clock() + 1.0
    repeat
        placeBtn = findByPath(playerGui, "MainHud.Elements.Hud.PlaceButton")
        if placeBtn and isGloballyVisible(placeBtn) then break end
        task.wait(0.1)
    until os.clock() >= pbDeadline

    local placed = false
    if placeBtn then
        forceClickObject(placeBtn)
        placed = true
    else
        warn("❌ Không tìm thấy PlaceButton (" .. unitName .. ")")
    end

    -- B5: Chờ game xử lý xong rồi hoàn nguyên slot + camera
    task.wait(0.35)
    if slot and slot.Parent == elements then
        slot.Parent = mainframe
    end
    localPlayer.CameraMode = Enum.CameraMode.Classic
    task.wait(STEP_DELAY)
    return placed
end

-- Đặt unit có RETRY: tự thử lại tối đa maxTries lần nếu hụt
local function deploySingleUnit(unitName, targetPos, maxTries)
    maxTries = maxTries or 3
    for attempt = 1, maxTries do
        if not isRunning then return false end
        local ok = deploySingleUnitOnce(unitName, targetPos)
        if ok then
            print(string.format("✅ Đặt Unit %s @ %s (lần %d)", unitName, tostring(targetPos), attempt))
            return true
        end
        warn(string.format("⚠️ Hụt Unit %s (lần %d/%d) – thử lại...", unitName, attempt, maxTries))
        task.wait(0.4)
    end
    warn("❌ Bỏ qua Unit " .. unitName .. " sau " .. maxTries .. " lần thử.")
    return false
end

