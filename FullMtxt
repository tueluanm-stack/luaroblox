-- [G] HÀM NÂNG CẤP (từ nâng.txt – đã tối ưu)
-- ============================================================
local function isTeamMenuOpen()
    local menu = findByPath(playerGui, "MainHud.Menus.TeamManager.Menu")
    return menu ~= nil and menu.Visible == true
end

local function toggleTeamMenu()
    local btn = findByPath(playerGui, "MainHud.Elements.RightMenu.teamManagement")
    if btn then safeClick(btn)
    else warn("❌ Không tìm thấy nút teamManagement!") end
end

local function closeTeamMenu()
    if not isTeamMenuOpen() then return end
    local closeBtn = findByPath(playerGui, "MainHud.Menus.TeamManager.Menu.Towers.CloseButton")
    if closeBtn then safeClick(closeBtn)
    else toggleTeamMenu() end
    task.wait(0.25)
end

-- Spam nâng cấp slot từ slotA đến slotB trong durationSec giây
local function runUpgradeCycle(slotA, slotB, durationSec)
    if not isRunning then return end
    setStatus(string.format("Nâng cấp slot %d→%d / %ds...", slotA, slotB, durationSec))

    -- Mở bảng nếu chưa mở
    if not isTeamMenuOpen() then
        toggleTeamMenu()
        task.wait(0.5)
    end

    local deadline = os.clock() + durationSec
    while isRunning and os.clock() < deadline do
        -- Tự mở lại nếu game đóng ngầm
        if not isTeamMenuOpen() then
            toggleTeamMenu()
            task.wait(0.25)
        end
        -- Quét và click nút Upgrade của từng slot
        for i = slotA, slotB do
            if not isRunning then break end
            local upgradeBtn = findByPath(playerGui,
                "MainHud.Menus.TeamManager.Menu.Towers.Listings." .. i .. ".UpgradeButtons.Upgrade"
            )
            if upgradeBtn then safeClick(upgradeBtn) end
        end
        task.wait(0.1) -- Nghỉ ngắn 100ms giữa các vòng quét
    end

    task.wait(0.3)
    closeTeamMenu()
    print(string.format("✅ Xong nâng cấp slot %d→%d!", slotA, slotB))
end

-- ============================================================
-- [H] HÀM CHỜ VÀ CLICK NÚT GAME FLOW (từ 4 tổ hợp.txt)
-- ============================================================
local function waitAndClick(path, timeoutSec)
    timeoutSec = timeoutSec or 90
    local label = path:match("[^.]+$")  -- Lấy tên node cuối để log
    setStatus("Chờ: " .. label .. "...")
    local deadline = os.clock() + timeoutSec

    while isRunning and os.clock() < deadline do
        local btn = findByPath(playerGui, path)
        if btn and isGloballyVisible(btn) then
            task.wait(0.1)
            safeClick(btn)
            print("✅ Đã click: " .. label)
            return true
        end
        task.wait(0.3)
    end
    warn("⚠️ Timeout khi chờ: " .. label)
    return false
end

-- Chờ VÔ HẠN cho nút PlayAgain (không bao giờ tự tắt cho tới khi nó hiện
-- hoặc người dùng bấm DỪNG). Tránh lỗi "chờ một lúc tự tắt" do timeout.
local function waitForPlayAgain(path)
    local label = path:match("[^.]+$")
    local waited = 0
    while isRunning do
        local btn = findByPath(playerGui, path)
        if btn and isGloballyVisible(btn) then
            task.wait(0.2)
            -- Click vài lần cho chắc ăn
            for _ = 1, 3 do
                if not isRunning then break end
                safeClick(btn)
                task.wait(0.25)
                -- Nếu nút biến mất nghĩa là đã bấm thành công
                if not (btn.Parent and isGloballyVisible(btn)) then break end
            end
            print("✅ Đã click: " .. label)
            return true
        end
        task.wait(0.5)
        waited = waited + 0.5
        -- Cập nhật trạng thái mỗi 10s để biết macro vẫn đang sống
        if waited % 10 < 0.5 then
            setStatus(string.format("Chờ kết thúc game + PlayAgain... (%ds)", math.floor(waited)))
        end
    end
    return false
end

-- ============================================================
-- [I] VÒNG LẶP MACRO CHÍNH
-- ============================================================
local function runMacro()
    local round = 0

    while isRunning do
        round = round + 1
        setStatus("Vòng #" .. round .. " – Vào game...")

        -- ──────────────────────────────────────────────────────
        -- PHASE 0: TỰ ĐỘNG VÀO GAME
        -- ──────────────────────────────────────────────────────
        waitAndClick(PATHS.Play,       180) ; task.wait(0.7)
        waitAndClick(PATHS.Difficulty, 90)  ; task.wait(0.7)

        if not waitAndClick(PATHS.StartGame, 180) then
            setStatus("Không bắt được StartGame, thử lại...")
            task.wait(3)
            continue
        end
        task.wait(2.0)  -- Đợi map load xong
        if not isRunning then break end

        -- ──────────────────────────────────────────────────────
        -- PHASE 1: ĐẶT UNIT Ô 5 — ĐIỂM 1 & 2
        -- ──────────────────────────────────────────────────────
        setStatus("Đặt Unit 5 → [1] & [2]")
        deploySingleUnit("5", PATH_POSITIONS[1])
        deploySingleUnit("5", PATH_POSITIONS[2])

        -- Nghỉ 5 giây sạc năng lượng
        setStatus("Nghỉ 5 giây sạc năng lượng...")
        task.wait(5)
        if not isRunning then break end

        -- ──────────────────────────────────────────────────────
        -- PHASE 2: ĐẶT UNIT Ô 5 — ĐIỂM 3 & 4
        -- (Ô 5 tự trả về Hotbar sau mỗi lần đặt)
        -- ──────────────────────────────────────────────────────
        setStatus("Đặt Unit 5 → [3] & [4]")
        deploySingleUnit("5", PATH_POSITIONS[3])
        deploySingleUnit("5", PATH_POSITIONS[4])
        if not isRunning then break end

        -- ──────────────────────────────────────────────────────
        -- PHASE 3: NÂNG CẤP SLOT 1→4 / 31 GIÂY → ĐÓNG MENU → NGHỈ 4 GIÂY
        -- ──────────────────────────────────────────────────────
        runUpgradeCycle(1, 4, 31)
        if not isRunning then break end
        setStatus("Nghỉ 4 giây trước PHASE 4...")
        task.wait(4)
        if not isRunning then break end

        -- ──────────────────────────────────────────────────────
        -- PHASE 4: ĐẶT UNIT Ô 3 — ĐIỂM 5
        -- ──────────────────────────────────────────────────────
        setStatus("Đặt Unit 3 → [5]")
        deploySingleUnit("3", PATH_POSITIONS[5])

        -- Nghỉ 25 giây
        setStatus("Nghỉ 25 giây sau điểm 5...")
        task.wait(25)
        if not isRunning then break end

        -- ──────────────────────────────────────────────────────
        -- PHASE 5: ĐẶT UNIT Ô 3 — ĐIỂM 6 → 9 (lần lượt)
        -- ──────────────────────────────────────────────────────
        setStatus("Đặt Unit 3 → [6] [7] [8] [9]")
        deploySingleUnit("3", PATH_POSITIONS[6])
        deploySingleUnit("3", PATH_POSITIONS[7])
        deploySingleUnit("3", PATH_POSITIONS[8])
        deploySingleUnit("3", PATH_POSITIONS[9])
        if not isRunning then break end

        -- ──────────────────────────────────────────────────────
        -- PHASE 6: ĐẶT UNIT ĐẶC BIỆT — ĐIỂM 10 / 11 / 12
        -- ──────────────────────────────────────────────────────
        setStatus("Đặt Unit 2→[10]  1→[11]  4→[12]")
        deploySingleUnit("2", PATH_POSITIONS[10])  -- ô 2 @ Point 10
        deploySingleUnit("1", PATH_POSITIONS[11])  -- ô 1 @ Point 11
        deploySingleUnit("4", PATH_POSITIONS[12])  -- ô 4 @ Point 12
        if not isRunning then break end

        -- ──────────────────────────────────────────────────────
        -- PHASE 7: NÂNG CẤP SLOT 5→12 / 90 GIÂY → ĐÓNG MENU
        -- ──────────────────────────────────────────────────────
        runUpgradeCycle(5, 12, 90)
        if not isRunning then break end

        -- ──────────────────────────────────────────────────────
        -- PHASE 8: CHỜ NÚT PLAYAGAIN → CLICK → LẶP LẠI
        -- ──────────────────────────────────────────────────────
        setStatus("Chờ kết thúc game + PlayAgain...")
        waitForPlayAgain(PATHS.PlayAgain)  -- Chờ VÔ HẠN, không tự tắt
        task.wait(1.5)  -- Nghỉ trước khi vào vòng tiếp theo
    end

    -- Dọn dẹp khi thoát
    pcall(function() localPlayer.CameraMode = Enum.CameraMode.Classic end)
    StartBtn.Text             = "🚀 BẮT ĐẦU MACRO"
    StartBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 220)
    setStatus("Đã dừng.")
    isRunning = false
end

